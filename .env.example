# Environment Variables Template (.env.example)
# Copy to .env or .env.local to configure locally or in GitHub Secrets

# MongoDB Atlas Proxy / API Endpoint (Optional)
VITE_MONGO_API_ENDPOINT=https://your-api-domain.com/api/telemetry

# Custom Admin Password SHA-256 Hash (Optional)
VITE_ADMIN_PASS_HASH=your_sha256_hash_here

# Backend Analytics Tunnel URL
VITE_ANALYTICS_URL=https://your-analytics-url.trycloudflare.com
